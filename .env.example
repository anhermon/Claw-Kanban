# Server configuration
PORT=8788              # default; 8787 is avoided (commonly taken by local proxies). vite.config.ts reads PORT too
HOST=127.0.0.1          # Use 0.0.0.0 for LAN/Tailscale access (then KANBAN_TOKEN is required)

# API auth. Required when HOST is not loopback (server refuses to start without it).
# Generate with: openssl rand -hex 32. Clients send `Authorization: Bearer <token>`;
# browsers visit the dashboard once with ?token=<token> to receive a cookie.
# KANBAN_TOKEN=
# Extra comma-separated origins allowed by CORS (board's own localhost origins are always allowed).
# KANBAN_ALLOWED_ORIGINS=http://my-mac.tailnet.ts.net:8788

# Database path (defaults to ./kanban.sqlite)
# DB_PATH=/path/to/kanban.sqlite

# Logs directory (defaults to ./logs)
# LOGS_DIR=/path/to/logs

# OpenClaw gateway integration (optional)
# Set this to enable wake notifications when cards change status.
# OPENCLAW_CONFIG=~/.openclaw/openclaw.json

# OAuth Connect (optional)
# Required when using Settings > OAuth Connect. Tokens are encrypted at rest in sqlite.
# OAUTH_ENCRYPTION_SECRET=replace-with-long-random-secret
# OAUTH_BASE_URL=http://127.0.0.1:8788
#
# GitHub/Copilot OAuth app
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
#
# Google OAuth app for Antigravity
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
#
# Optional: comma-separated allowlist for absolute redirect_to hosts.
# OAUTH_ALLOWED_REDIRECT_HOSTS=127.0.0.1,localhost
